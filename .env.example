# Unified AI platform - environment template for the single deployment.
# Copy to .env and adjust before starting Compose.

# --- AI Quality & Safety Gateway ---
GATEWAY_API_KEY=change-me-to-a-random-32-plus_char_value
OPENAI_API_KEY=
OPENAI_DEFAULT_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_DEFAULT_MODEL=
DEFAULT_PROVIDER=local
LOCAL_BASE_URL=http://ollama:11434/v1
LOCAL_MODEL=llama3.2:1b
SAFETY_ENABLED=true
SAFETY_REDACT_PII=true
SAFETY_BLOCK_INJECTIONS=true
RATE_LIMIT_ENABLED=true

# --- RAG chain (chat + embeddings flow through the gateway via LLM_BASE_URL) ---
APP_ENV=development
DATABASE_URL=postgresql+psycopg://rag:rag@db:5432/rag
REDIS_URL=redis://redis:6379/0
UPLOAD_DIR=/data/uploads
LLM_BASE_URL=http://gateway:8000/v1
LLM_API_KEY=change-me-to-the-same-value-as-GATEWAY_API_KEY
PRIMARY_MODEL=llama3.2:1b
FALLBACK_MODEL=llama3.2:1b
EMBEDDING_MODEL=nomic-embed-text
VECTOR_COLLECTION_NAME=documents
RETRIEVAL_K=4
RETRIEVAL_CANDIDATES_K=12
MAX_CONTEXT_CHARS=12000
QUERY_EXPANSION_ENABLED=true
QUERY_EXPANSION_COUNT=2
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
COHERE_API_KEY=
RERANK_MODEL=rerank-v3.5
RERANK_CANDIDATES_K=30
TENANT_ID=local
INGEST_API_KEY=local-ingest-key
CHAT_API_KEY=
RATE_LIMIT=20/minute
INGEST_RATE_LIMIT=5/minute
MAX_INGEST_CHARS=250000
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
MAX_UPLOAD_BYTES=50000000
MAX_DOCUMENT_PAGES=1000
MAX_DOCUMENT_CHARS=5000000

# --- LangSmith tracing (optional) ---
LANGSMITH_TRACING=false

# --- SandboxMCP (points at the shared RAG database) ---
SANDBOX_MCP_TRANSPORT=http
SANDBOX_DB_URL=postgresql+psycopg://rag:rag@db:5432/rag
SANDBOX_LOG_FILE=/var/log/sandbox/service.log
SANDBOX_DOCKER_IMAGE=python:3.14-slim
SANDBOX_DOCKER_MEMORY_MB=256
SANDBOX_DOCKER_CPU_CORES=0.5
SANDBOX_TEST_TIMEOUT_SECONDS=30
